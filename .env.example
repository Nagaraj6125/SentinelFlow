# SentinelFlow Environment Configuration Template
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control!

# ArmorIQ API Key (from https://armoriq.ai control plane)
ARMORIQ_API_KEY=ak_live_your_armoriq_api_key_here

# LLM API Key (Google Gemini API key)
LLM_API_KEY=your_gemini_api_key_here

# Supabase Project Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key_here
